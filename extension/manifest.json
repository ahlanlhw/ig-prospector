{
  "manifest_version": 3,
  "name": "Sprill: DM Read Rate Tracker",
  "version": "0.18.0",
  "key": "",
  "description": "Confirm every DM and comment you send on instagram.com, then track which ones were read and which got replies. No bulk sending.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "activeTab",
    "scripting",
    "identity"
  ],
  "host_permissions": [
    "https://www.instagram.com/*"
  ],
  "optional_host_permissions": [
    "https://sheets.googleapis.com/*",
    "https://firestore.googleapis.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Sprill: open panel"
  },
  "side_panel": {
    "default_path": "src/sidepanel/panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "src/content/instagram.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}